# Copy to .env and adjust.

# Your time zone. Decides when "today" starts and when weekly chores reset (Mondays).
TZ=America/Los_Angeles

# Delete chore photos this many days after they're reviewed (history and stars are kept).
# 0 keeps photos forever.
PHOTO_RETENTION_DAYS=30

# The address you open the app at. Used as the link in notifications.
APP_URL=https://chores.example.com

# Optional: push a notification to your phones when a kid turns in a chore.
# Install the free "ntfy" app, subscribe to a hard-to-guess topic, and put its URL here.
# Works with ntfy.sh or your own ntfy server.
NTFY_URL=
# NTFY_URL=https://ntfy.sh/our-family-chores-8f3k2
NTFY_TOKEN=

# Optional: fix the first-run setup code instead of a random one printed in the log.
# SETUP_CODE=

# Only needed if you use the Cloudflare Tunnel profile in docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=
